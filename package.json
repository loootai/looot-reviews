{
  "name": "looot-reviews",
  "version": "0.1.5",
  "description": "Open-source review intelligence. Reads reviews from Google Maps, the App Store, Google Play and Tripadvisor through looot, groups them into themes and shows where competitors are weak.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "demo": "node scripts/demoGuard.mjs && NEXT_PUBLIC_DEMO=1 next dev -p 3240",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint .",
    "reviews": "tsx src/cli/index.ts",
    "leak-scan": "bash scripts/leak-scan.sh .",
    "hash-password": "node scripts/hashPassword.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "geist": "1.7.2",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
