# looot agent token. Server side only, never sent to the browser.
# Create one with `looot login`, or in the looot web app under Settings, "Agent tokens".
# Needed for a real pull. Not needed for `npm run demo`, `--dry-run` or `--demo`.
LOOOT_TOKEN=your-looot-agent-token
# Admin password for the web UI. 12 characters or more. Required outside the demo.
# Without it every page except /login stays closed and /login shows a setup page.
REVIEWS_ADMIN_PASSWORD=
# Alternative to the plain password: the output of `npm run hash-password -- 'your password'`. Wins if both are set.
# REVIEWS_ADMIN_PASSWORD_HASH=
# Optional. Spend cap in dollars for one pull started from the web UI. Default 0.50. The browser cannot change it.
# REVIEWS_SPEND_CAP_USD=0.50
# Optional. Starting daily and monthly budget in dollars, defaults 10 and 50. The owner changes them on the Costs page.
# LOOOT_REVIEWS_DAILY_USD=
# LOOOT_REVIEWS_MONTHLY_USD=
# Optional. Key that signs session cookies. Default: derived from the password, so a new password signs everyone out.
# REVIEWS_SESSION_SECRET=
# Optional. Set to 0 only to test over plain http in production mode. Leave unset otherwise.
# REVIEWS_COOKIE_SECURE=
# Optional, defaults to https://api.looot.ai
LOOOT_API_URL=https://api.looot.ai
# Optional, where the web UI saves the last pull and the budget file (budget.json). Default: ./.looot-data
# The budget file needs one instance on a persistent disk.
# LOOOT_REVIEWS_DATA_DIR=

# Optional LLM step that merges and renames themes. Off unless BOTH are set.
# It sends theme labels, keywords and two short quotes per theme, never the full review set.
# Billed by your model provider, not by looot.
# REVIEWS_LLM_API_KEY=
# REVIEWS_LLM_MODEL=
# REVIEWS_LLM_BASE_URL=https://api.anthropic.com
